{
  "manifest_version": 3,
  "name": "ToxiShield",
  "version": "1.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ToxiShield",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["scripting", "activeTab"],
  "host_permissions": [
    "https://*.hf.space/*",
    "http://127.0.0.1:5001/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.youtube.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
